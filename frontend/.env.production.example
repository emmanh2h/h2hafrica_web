# Copy to .env.production on the server (or set these as environment
# variables in Plesk's Node.js application settings). Never commit the
# real .env.production — it's gitignored.

NEXT_PUBLIC_WORDPRESS_URL=https://happy2host.africa/cmsadmin
WORDPRESS_GRAPHQL_URL=https://happy2host.africa/cmsadmin/graphql

# Remove this once the frontend moves from /main to the domain root.
NEXT_BASE_PATH=/main
